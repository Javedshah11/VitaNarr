{
  "name": "vitanarr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names frontend,api,intelligence --prefix-colors cyan,magenta,yellow \"pnpm dev:frontend\" \"pnpm dev:api\" \"pnpm dev:intelligence\"",
    "dev:frontend": "pnpm --filter @vitanarr/frontend dev",
    "dev:api": "pnpm --filter @vitanarr/api start:dev",
    "dev:intelligence": "node scripts/run-intelligence.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @vitanarr/api db:generate",
    "db:migrate": "pnpm --filter @vitanarr/api db:migrate"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "turbo": "^2.11.3"
  }
}
